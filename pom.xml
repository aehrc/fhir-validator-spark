<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>au.csiro.fhir</groupId>
    <artifactId>fhir-validator-spark</artifactId>
    <version>1.0.0</version>

    <properties>
        <project.majorVersion>6</project.majorVersion>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <pathling.sparkVersion>4.0.2</pathling.sparkVersion>
        <pathling.scalaVersion>2.13</pathling.scalaVersion>
        <pathling.scalaFullVersion>2.13.16</pathling.scalaFullVersion>
        <pathling.lombokVersion>1.18.34</pathling.lombokVersion>
        <hapi.validationVersion>6.5.26</hapi.validationVersion>
        <hapi.structuresVersion>8.2.0</hapi.structuresVersion>
        <fasterxml.jacksonVersion>2.18.2</fasterxml.jacksonVersion>
        <shaded.dependency.prefix>au.csiro.fhir.validation.shaded</shaded.dependency.prefix>

    </properties>


    <dependencies>
        <!--  BEGIN: hapi validator dependencies -->
        <!-- https://mvnrepository.com/artifact/ca.uhn.hapi.fhir/org.hl7.fhir.validation -->
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>org.hl7.fhir.validation</artifactId>
            <version>${hapi.validationVersion}</version>
            <exclusions>
                <exclusion>
                    <groupId>info.cqframework</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r4</artifactId>
            <version>${hapi.structuresVersion}</version>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r5</artifactId>
            <version>${hapi.structuresVersion}</version>
        </dependency>
        <dependency>
            <groupId>org.fhir</groupId>
            <artifactId>ucum</artifactId>
            <version>1.0.3</version>
        </dependency>
        <!-- https://mvnrepository.com/artifact/com.squareup.okhttp3/okhttp -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.11.0</version>
        </dependency>

        <!--  END: hapi validator dependencies -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${pathling.lombokVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-core_${pathling.scalaVersion}</artifactId>
            <version>${pathling.sparkVersion}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${pathling.scalaVersion}</artifactId>
            <version>${pathling.sparkVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.0</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire plugin to run the tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <!-- So that HapiLibraryVersionTest can compare the resolved
                             hapi-fhir-base version against the version this build asks
                             the structures modules for. -->
                        <hapi.structuresVersion>${hapi.structuresVersion}</hapi.structuresVersion>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- shade plugin to build the fat jar -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>au.csiro.fhir.validation.cli.ValidateApp</mainClass>
                                </transformer>
                            </transformers>
                            <relocations>
                                <relocation>
                                    <pattern>org/</pattern>
                                    <shadedPattern>${shaded.dependency.prefix}.org.</shadedPattern>
                                    <includes>
                                        <include>org/apache/commons/compress/**</include>
                                    </includes>
                                </relocation>
                                <relocation>
                                    <pattern>com/</pattern>
                                    <shadedPattern>${shaded.dependency.prefix}.com.</shadedPattern>
                                    <includes>
                                        <!--include>com/fasterxml/jackson/**</include-->
                                        <include>com/google/gson/**</include>
                                        <include>com/github/benmanes/caffeine/**</include>
                                    </includes>
                                </relocation>
                                <relocation>
                                    <pattern>okhttp3/</pattern>
                                    <shadedPattern>${shaded.dependency.prefix}.okhttp3.</shadedPattern>
                                    <includes>
                                        <include>okhttp3/**</include>
                                    </includes>
                                </relocation>
                                <relocation>
                                    <pattern>okio/</pattern>
                                    <shadedPattern>${shaded.dependency.prefix}.okio.</shadedPattern>
                                    <includes>
                                        <include>okio/**</include>
                                    </includes>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


    <dependencyManagement>
        <dependencies>
            <!-- Pinned to the version Spark 4.0.x ships, since Spark provides Jackson at runtime. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${fasterxml.jacksonVersion}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${fasterxml.jacksonVersion}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${fasterxml.jacksonVersion}</version>
            </dependency>
            <!--
              Pinned to the structures version. `org.hl7.fhir.validation` depends on
              hapi-fhir-base 6.4.1 and the structures modules on 8.2.0; without this
              entry Maven's nearest-wins rule takes 6.4.1, and the shaded jar then
              ships a base library older than the structures built against it. That
              mismatch removes `MethodOutcome.setResponseStatusCode`, which any HAPI
              8.x client on the same class path calls, so a consumer such as Pathling
              fails with `NoSuchMethodError` as soon as it talks to a FHIR server.
            -->
            <dependency>
                <groupId>ca.uhn.hapi.fhir</groupId>
                <artifactId>hapi-fhir-base</artifactId>
                <version>${hapi.structuresVersion}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>dist</id>
            <build>
                <!-- use assembly plugin to build the zip file with the distribution -->
                <!-- include the shaded jar, bin scrips, data, and fhir files -->
                <!-- inline the assembly descriptor -->
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <executions>
                            <execution>
                                <id>make-assembly</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <inlineDescriptors>
                                        <assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
                                                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                                  xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
                                            <id>dist</id>
                                            <formats>
                                                <format>tar.gz</format>
                                            </formats>
                                            <includeBaseDirectory>true</includeBaseDirectory>
                                            <fileSets>
                                                <fileSet>
                                                    <directory>${project.basedir}</directory>
                                                    <outputDirectory>/</outputDirectory>
                                                    <includes>
                                                        <include>README.md</include>
                                                        <include>LICENSE</include>
                                                    </includes>
                                                </fileSet>
                                                <fileSet>
                                                    <directory>${project.build.directory}</directory>
                                                    <outputDirectory>/lib</outputDirectory>
                                                    <includes>
                                                        <include>*-all.jar</include>
                                                    </includes>
                                                </fileSet>
                                                <fileSet>
                                                    <directory>bin</directory>
                                                    <outputDirectory>/bin</outputDirectory>
                                                    <includes>
                                                        <include>*</include>
                                                    </includes>
                                                </fileSet>
                                                <fileSet>
                                                    <directory>data</directory>
                                                    <outputDirectory>/data</outputDirectory>
                                                    <includes>
                                                        <include>**/*</include>
                                                    </includes>
                                                </fileSet>
                                                <fileSet>
                                                    <directory>env</directory>
                                                    <outputDirectory>/env</outputDirectory>
                                                    <includes>
                                                        <include>**/*</include>
                                                    </includes>
                                                </fileSet>
                                            </fileSets>
                                        </assembly>
                                    </inlineDescriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>